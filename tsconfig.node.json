{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "electron/main/**/*",
    "electron/preload/**/*",
    "electron/preload/*.d.ts",
    "scripts/**/*",
    "platform/android/vite.config.ts",
    "platform/android/bridge.ts",
    "shared/**/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.node.tsbuildinfo",
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./electron/main/*"],
      "@shared/*": ["./shared/*"],
      "@android/*": ["./platform/android/*"],
      "@splayer/audio-engine": ["./native/audio-engine"],
      "@splayer/audio-capture": ["./native/audio-capture"],
      "@splayer/media-ctrl": ["./native/media-ctrl"],
      "@splayer/taskbar-lyric": ["./native/taskbar-lyric"],
      "@splayer/taskbar-thumbnail": ["./native/taskbar-thumbnail"],
      "@splayer/opencc": ["./native/opencc"]
    }
  }
}
